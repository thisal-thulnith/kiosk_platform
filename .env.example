# edge = in the venue (orders, KDS, printers). cloud = central admin, reports, sync.
APP_MODE=edge
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./kiosk.db
# DATABASE_URL=postgresql+asyncpg://kiosk:kiosk@localhost:5432/kiosk

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-000
GATEWAY_WEBHOOK_SECRET=dev-webhook-secret
TERMINAL_WEBHOOK_SECRET=dev-terminal-secret
# Encrypts merchant API keys at rest. Required in prod. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Public HTTPS address of the cloud, used in the URL you type into cloud printers (CloudPRNT).
PUBLIC_URL=

# Edge only. Leave CLOUD_URL empty to run standalone (no sync).
VENUE_ID=
CLOUD_URL=
CLOUD_SYNC_KEY=

PRINT_DIR=./prints
