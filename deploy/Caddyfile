# HTTPS for the restaurants' address (DOMAIN) and our team's address (ADMIN_DOMAIN). Caddy gets and renews the certificate by itself (Let's Encrypt), which works
# with Cloudflare set to "Full (strict)". Visitors' real addresses come from Cloudflare's header.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN}, {$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Built files have a hash in their name: cache them for a year. Pages and the API: never.
	@static path /static/assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy app:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The public demo (its own app and data). Without DEMO_DOMAIN this block only answers demo.localhost.
{$DEMO_DOMAIN:demo.localhost} {
	encode zstd gzip
	header -Server
	@static path /static/assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy demo:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The bare server address (no domain) goes to the domain.
:80 {
	redir https://{$DOMAIN}{uri} permanent
}
